  "guide": [
    {
      "title": "Lighting",
      "icon": "on",
      "text": "Use Lights on and Lights off on Home for everyday lighting.\n\nRoom tools → Lighting brings White light, Scenes, Programmes and Channels together. Opening a tab does not change the lights.\n\nA highlighted button shows the last confirmed setting. If a result is unconfirmed, do not repeat it. Check connection reads current lighting without changing it; ask the room host if controls stay unavailable."
    },
    {
      "title": "Room controls",
      "icon": "home",
      "text": "Home opens the everyday room page. Opening a page does not change the lights.\n\nLegacy opens the original controls. Home stops any Legacy programme and returns to Beta after checking the connection, keeping current light levels. If controls stay unavailable, ask the room host.\n\nLift blinds, Open slats and Close & lower are on Home. Room tools → Screen & controls saves whether blind movement is enabled and whether the controls are shown. Movement is disabled by default and also requires a connected controller."
    },
    {
      "title": "Sensors and experiments",
      "icon": "experiment",
      "text": "Experiment mode guides a repeatable sequence of instructions and saves panel annotations.\n\nIt does not start a recorder. Arrange recording separately. An experiment must reserve lighting before it starts, then close its workers and return verified everyday control when finished.\n\nRoom tools → System & help shows room service availability. Availability alone does not prove usable sensor data."
    },
    {
      "title": "How it connects",
      "icon": "health",
      "text": "Beta and the trusted-network website share one room controller. Legacy hands control to the unchanged original application.\n\nThe lighting status explains when controls are ready, reserved for an experiment, checking or unconfirmed. Website offline means the page cannot reach the panel. Open System & help for guidance.\n\nWeather is an outdoor model estimate, separate from indoor measurements. Source details are under Room tools → Date & weather."
    }
  ],
  "help": [
    {
      "title": "Lighting",
      "text": "Ready means the lighting adapter is available. Sending means a request is awaiting readback.\n\nIf Lighting result unconfirmed appears, do not repeat the command. Check connection reads current settings without changing them or clearing an uncertain result. An experiment reservation cannot be overridden here.\n\nIf the connection stays unavailable, ask the room host to check it.",
      "commands": "",
      "command_tokens": [],
      "reference": {
        "machine": "",
        "effect": "",
        "documentation": null,
        "steps": []
      }
    },
    {
      "title": "Power",
      "text": "Low supply voltage can slow the Pi and affect storage reliability. Check its supply, cable and connector; a separately powered LCD does not rule out a Pi power problem.\n\nOpen the reference to distinguish current warnings from earlier ones. Do not hide warnings or repeatedly power-cycle. Shut down normally before changing power.",
      "commands": "vcgencmd get_throttled",
      "command_tokens": [
        {
          "text": "vcgencmd",
          "kind": "command"
        },
        {
          "text": " ",
          "kind": "text"
        },
        {
          "text": "get_throttled",
          "kind": "text"
        }
      ],
      "reference": {
        "machine": "Raspberry Pi",
        "effect": "Read only",
        "documentation": {
          "label": "Raspberry Pi power flags",
          "url": "https://github.com/raspberrypi/documentation/blob/master/documentation/asciidoc/computers/os/graphics-utilities.adoc#get_throttled"
        },
        "steps": [
          {
            "title": "Check power warnings",
            "commands": "vcgencmd get_throttled",
            "why": "Read the Pi firmware flags when the panel is slow or reports a power warning.",
            "expect": "0x0 means no flags. Nonzero can include earlier warnings; it does not always mean a fault is active now.",
            "command_tokens": [
              {
                "text": "vcgencmd",
                "kind": "command"
              },
              {
                "text": " ",
                "kind": "text"
              },
              {
                "text": "get_throttled",
                "kind": "text"
              }
            ]
          }
        ]
      }
    },
    {
      "title": "Ubuntu checks",
      "text": "Use a Terminal on the Ubuntu room computer. These commands inspect state; they do not start devices.\n\nROS owns room controls. Status owns the TV display and its clients. Session presence alone does not prove health.",
      "commands": "hostname\n\nuptime\n\nfree -m\n\ndf -h /\n\ntmux list-sessions\n\nsource /opt/ros/indigo/setup.bash\n\nsource ~/catkin_ws/devel/setup.bash\n\ntimeout 10 rosservice list",
      "command_tokens": [
        {
          "text": "hostname",
          "kind": "command"
        },
        {
          "text": "\n",
          "kind": "text"
        },
        {
